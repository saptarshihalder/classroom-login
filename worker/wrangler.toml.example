name = "course-boards"
main = "src/index.js"
compatibility_date = "2026-08-20"

[vars]
# where the public site is published
SITE_URL = "https://saptarshihalder.github.io/classroom-login/"
# optional: only let one organisation's accounts publish, e.g. "university.edu"
# ALLOWED_DOMAIN = ""
# largest ordinary Drive attachment published, in megabytes
MAX_FILE_MB = "20"
# attachments prepared per run
MIRROR_BATCH = "6"
# accounts refreshed per scheduled run
ACCOUNTS_PER_RUN = "3"

[[kv_namespaces]]
binding = "STATE"
id = "replace-with-kv-id"

[triggers]
crons = ["*/10 * * * *"]
